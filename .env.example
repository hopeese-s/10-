# ─── E-Calendar Environment Configuration ──────────────────────
# Copy this file to .env or configure in Railway / Server Environment

# Server Port
PORT=3000

# ─── Supabase PostgreSQL Database (Optional - Auto-fallback to Local Store) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Cloudflare R2 Object Storage (Optional - Auto-fallback to /uploads/ disk) ─
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
# Public Custom Domain or R2 Dev URL (e.g., https://pub-xxxx.r2.dev or https://assets.yourdomain.com)
R2_PUBLIC_DOMAIN=https://your-r2-public-domain.com

# ─── Web Push Notifications VAPID Keys (Auto-generated if not provided) ───────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@e-calendar.app

# ─── LINE Messaging API Bot & LIFF Configuration ──────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_LIFF_ID=your-line-liff-id

# ─── Google Gemini AI API (Multimodal Vision, Audio & Smart NLP) ───────────────
GEMINI_API_KEY=your-google-gemini-api-key

