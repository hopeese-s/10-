# LINE Messaging API Credentials (from LINE Developers Console)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Drive Service Account Credentials
# Paste either the full JSON string or provide path to service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_PARENT_ID=your_google_drive_folder_id_here

# E-Calendar Integration Endpoints
ECALENDAR_SCHEDULE_URL=https://e-calen.up.railway.app/api/schedule
ECALENDAR_BACKUP_URL=https://e-calen.up.railway.app/api/backup
ECALENDAR_SYNC_KEY=1

# Operational Parameters
SCHEDULE_CACHE_TTL_SECONDS=300
SESSION_DEBOUNCE_SECONDS=150
GRACE_PERIOD_MINUTES=30
TIMEZONE=Asia/Bangkok
PORT=8000
